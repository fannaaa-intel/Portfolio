---
import TechIcon from "./TechIcon.astro";
import { getTechIcon } from "../lib/techIcons";

interface Props {
  label: string;
  /** Show the monochrome tech logo before the label */
  icon?: boolean;
  class?: string;
}

const { label, icon = false, class: className = "" } = Astro.props;
// Small tags only show logos that stay legible at 14px
const showIcon = icon && !getTechIcon(label)?.wordmark;
---

<span
  class:list={[
    "inline-flex items-center gap-1 border border-border px-2 py-1 font-mono text-xs leading-none whitespace-nowrap transition-colors duration-200",
    className,
  ]}
>
  <span aria-hidden="true" class="opacity-60">[</span>
  {showIcon && <TechIcon name={label} class="mx-0.5 size-3.5" />}
  {label}
  <span aria-hidden="true" class="opacity-60">]</span>
</span>
