---
import SectionHeader from "./SectionHeader.astro";
import { experience } from "../data/site";
---

<section id="experience" aria-labelledby="experience-title" class="container-page reveal py-20 md:py-28">
  <SectionHeader index="04" label="Experience" title={experience.title} id="experience-title" />

  <ol
    class="relative ml-1.5 border-l border-border md:ml-0 md:border-l-0 md:before:absolute md:before:inset-y-0 md:before:left-[14.5rem] md:before:w-px md:before:bg-border"
  >
    {
      experience.items.map((item) => (
        <li class="relative pb-14 pl-8 last:pb-0 md:grid md:grid-cols-[12rem_1fr] md:gap-10 md:pl-0">
          <!-- Timeline marker -->
          <span
            aria-hidden="true"
            class="absolute top-2 -left-[5px] size-[9px] border border-fg bg-bg md:left-[calc(14.5rem-4px)]"
          />
          <p class="mono-label pt-0.5 md:text-right">{item.dates}</p>
          <div class="mt-2 md:mt-0 md:pl-10">
            <h3 class="text-xl md:text-2xl">{item.role}</h3>
            <p class="mt-1 text-muted">
              {item.org}
              {item.note && (
                <>
                  {" · "}
                  <span class="hook text-fg">{item.note}</span>
                </>
              )}
            </p>
            {item.points && (
              <ul class="mt-5 space-y-2.5">
                {item.points.map((point) => (
                  <li class="flex gap-3">
                    <span aria-hidden="true" class="mono-label pt-1">—</span>
                    <span class="measure">{point}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</section>
