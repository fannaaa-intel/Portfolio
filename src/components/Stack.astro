---
import SectionHeader from "./SectionHeader.astro";
import TechIcon from "./TechIcon.astro";
import { stack } from "../data/site";
import { pad } from "../lib/hook";

let n = 0;
---

<section id="stack" aria-labelledby="stack-title" class="container-page reveal py-20 md:py-28">
  <SectionHeader index="02" label="Stack" title={stack.title} id="stack-title" />

  <div class="space-y-12 md:space-y-14">
    {
      stack.groups.map((group, g) => (
        <div class="grid gap-5 lg:grid-cols-[13rem_1fr] lg:gap-10">
          <h3 class="mono-label flex items-baseline gap-3 lg:flex-col lg:gap-1 lg:pt-4">
            <span class="text-fg">{pad(g + 1)}</span>
            <span>{group.label}</span>
          </h3>

          <ul
            class="grid grid-cols-2 pt-px pl-px sm:grid-cols-3 lg:grid-cols-4"
            aria-label={group.label}
          >
            {group.items.map((item) => {
              n += 1;
              return (
                <li class="card-invert group relative -mt-px -ml-px flex h-28 flex-col justify-between border border-border p-4 md:h-32">
                  <div class="flex items-start justify-between gap-2">
                    <TechIcon name={item} class="size-7 md:size-8" />
                    <span aria-hidden="true" class="font-mono text-[0.6875rem] text-muted">
                      {pad(n)}
                    </span>
                  </div>
                  <span class="font-mono text-sm">{item}</span>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</section>
