---
import type { GetStaticPaths } from "astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Tag from "../../components/Tag.astro";
import { pad } from "../../lib/hook";

export const getStaticPaths = (async () => {
  const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.data.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: CollectionEntry<"projects">;
  next: CollectionEntry<"projects">;
}

const { project, next } = Astro.props;
const { title, fullName, summary, hook, tech, role, year, order, live, repo, cover, coverAlt, gallery, video, status } =
  project.data;
// Phone screens get a narrow strip / 5-up grid; desktop screenshots get wider tiles / 2-up grid.
const wideGallery = gallery?.[0] ? gallery[0].src.width > gallery[0].src.height : false;
const { Content } = await render(project);
const index = pad(order);
---

<BaseLayout title={`${title} case study`} description={summary} type="article">
  <Nav />

  <main id="main">
    <!-- Header -->
    <header class="container-page pt-10 pb-12 md:pt-16 md:pb-16">
      <a href="/#projects" class="link-underline font-mono text-sm text-muted hover:text-fg">
        <span aria-hidden="true" class="nudge nudge-l">←</span> All projects
      </a>

      <div class="relative isolate mt-12 md:mt-16">
        <span
          aria-hidden="true"
          class="numeral-outline pointer-events-none absolute -top-10 right-0 -z-10 text-[7rem] md:-top-12 md:text-[12rem]"
        >
          {index}
        </span>

        <p class="mono-label">
          <span class="text-fg">P/{index}</span> / Case study
        </p>

        <h1 class="mt-5 text-[clamp(2.5rem,7vw,5rem)]">
          {title}{" "}
          <span class="hook mt-2 block text-[0.62em] text-pretty text-muted">— {hook}</span>
        </h1>

        <p class="mono-label mt-6">{fullName}</p>
        <p class="measure mt-6 text-xl leading-relaxed md:text-2xl">{summary}</p>
      </div>
    </header>

    <!-- Cover -->
    <div class="container-page">
      <figure class="corners group">
        {
          cover ? (
            <Image
              src={cover}
              alt={coverAlt ?? `${title} screenshot`}
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 1200px) 1100px, 100vw"
              loading="eager"
              class="aspect-[16/9] w-full border border-border object-cover grayscale transition-[filter] duration-500 group-hover:grayscale-0"
            />
          ) : (
            <div
              role="img"
              aria-label={`Screenshot of ${title} coming soon`}
              class="bg-dots flex aspect-[16/9] flex-col items-center justify-center gap-2 border border-border bg-surface md:aspect-[21/9]"
            >
              <span class="font-mono text-base">{title.toLowerCase()}</span>
              <span class="mono-label">screenshot coming soon</span>
            </div>
          )
        }
      </figure>
    </div>

    <!-- Body -->
    <div class="container-page grid gap-12 py-16 md:py-24 lg:grid-cols-[16rem_1fr] lg:gap-20">
      <aside class="lg:sticky lg:top-24 lg:h-fit" aria-label="Project details">
        <dl class="divide-y divide-border border-y border-border font-mono text-sm">
          <div class="grid grid-cols-[5rem_1fr] gap-3 py-3 lg:grid-cols-1 lg:gap-1">
            <dt class="text-muted">Year</dt>
            <dd>{year}</dd>
          </div>
          <div class="grid grid-cols-[5rem_1fr] gap-3 py-3 lg:grid-cols-1 lg:gap-1">
            <dt class="text-muted">Role</dt>
            <dd>{role}</dd>
          </div>
          <div class="grid grid-cols-[5rem_1fr] gap-3 py-3 lg:grid-cols-1 lg:gap-1">
            <dt class="text-muted">Status</dt>
            <dd class="flex items-center gap-2">
              {status === "Live" && <span aria-hidden="true" class="pulse-dot inline-block size-1.5 rounded-full bg-fg" />}
              {status}
            </dd>
          </div>
          <div class="grid grid-cols-[5rem_1fr] gap-3 py-3 lg:grid-cols-1 lg:gap-2">
            <dt class="text-muted">Stack</dt>
            <dd>
              <ul class="flex flex-wrap gap-2" aria-label="Tech used">
                {
                  tech.map((t) => (
                    <li>
                      <Tag label={t} icon />
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>
        </dl>

        {
          (live || repo) && (
            <div class="mt-6 flex flex-wrap gap-3">
              {live && (
                <a href={live} class="btn btn-solid" target="_blank" rel="noopener noreferrer">
                  Live site <span aria-hidden="true" class="nudge nudge-ne">↗</span>
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              )}
              {repo && (
                <a href={repo} class="btn" target="_blank" rel="noopener noreferrer">
                  Code <span aria-hidden="true" class="nudge nudge-ne">↗</span>
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              )}
            </div>
          )
        }
      </aside>

      <article class="prose-case min-w-0">
        <Content />
      </article>
    </div>

    <!-- Demo video -->
    {
      video && (
        <section aria-labelledby="demo-heading" class="container-page pb-24">
          <div class="flex items-end justify-between gap-4 border-t border-border pt-8">
            <h2 id="demo-heading" class="text-[clamp(1.625rem,3vw,2.25rem)]">Demo</h2>
            <p class="mono-label">
              {video.duration && <span class="text-fg">{video.duration}</span>}
              {video.duration && " · "}sound on
            </p>
          </div>
          <div
            class:list={[
              "mt-8",
              video.orientation === "portrait" &&
                "grid items-end gap-8 md:grid-cols-[minmax(0,20rem)_1fr] md:gap-12",
            ]}
          >
            <figure class="corners">
              <video
                controls
                playsinline
                preload="none"
                poster={video.poster}
                width={video.orientation === "portrait" ? 720 : 1280}
                height={video.orientation === "portrait" ? 1280 : 720}
                aria-label={`${title} demo video`}
                class:list={[
                  "block w-full border border-border bg-black",
                  video.orientation === "portrait" ? "mx-auto aspect-[9/16] max-w-[20rem]" : "aspect-video",
                ]}
              >
                <source src={video.src} type="video/mp4" />
                <a href={video.src}>Download the {title} demo video</a>
              </video>
            </figure>
            {video.description && (
              <p
                class:list={[
                  "measure text-muted",
                  video.orientation === "portrait" ? "text-lg leading-relaxed md:pb-4" : "mt-4",
                ]}
              >
                {video.description}
              </p>
            )}
          </div>
        </section>
      )
    }

    <!-- Screens -->
    {
      gallery && gallery.length > 0 && (
        <section aria-labelledby="screens-heading" class="container-page pb-24">
          <div class="flex items-end justify-between gap-4 border-t border-border pt-8">
            <h2 id="screens-heading" class="text-[clamp(1.625rem,3vw,2.25rem)]">Screens</h2>
            <p class="mono-label">
              {gallery.length} screens<span class="lg:hidden"> · swipe →</span>
            </p>
          </div>
          <ul
            class:list={[
              "mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4 md:gap-6 lg:grid lg:gap-x-6 lg:gap-y-10 lg:overflow-visible lg:pb-0",
              wideGallery ? "lg:grid-cols-2" : "lg:grid-cols-5",
            ]}
            aria-label={`${title} screenshots`}
            tabindex="0"
          >
            {gallery.map((shot, i) => (
              <li
                class:list={[
                  "shrink-0 snap-start lg:w-auto",
                  wideGallery ? "w-[85%] md:w-[30rem]" : "w-[13.5rem] md:w-[15rem]",
                ]}
              >
                <figure class="group">
                  <a href={shot.src.src} target="_blank" rel="noopener" class="block cursor-zoom-in">
                    <Image
                      src={shot.src}
                      alt={shot.alt}
                      widths={wideGallery ? [480, 720, 1080, 1366] : [240, 480, 720]}
                      sizes={
                        wideGallery
                          ? "(min-width: 1024px) 50vw, (min-width: 768px) 480px, 85vw"
                          : "(min-width: 1024px) 20vw, (min-width: 768px) 240px, 216px"
                      }
                      class:list={[
                        "w-full border border-border grayscale transition-[filter] duration-500 group-hover:grayscale-0",
                        wideGallery ? "rounded-md" : "rounded-[1.25rem]",
                      ]}
                    />
                    <span class="sr-only"> (full size, opens in a new tab)</span>
                  </a>
                  <figcaption class="mono-label mt-3">
                    <span class="text-fg">{pad(i + 1)}</span> {shot.caption ?? shot.alt}
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <!-- Next project -->
    <nav aria-label="Next project" class="container-page pb-24">
      <a
        href={`/projects/${next.data.slug}`}
        class="card-invert corners corners-hover group flex flex-col gap-6 border border-border p-6 md:flex-row md:items-end md:justify-between md:p-10"
      >
        <span>
          <span class="mono-label block">Next project · P/{pad(next.data.order)}</span>
          <span class="mt-3 block text-[clamp(2rem,5vw,3.5rem)] leading-tight font-semibold tracking-tight">
            {next.data.title}
            <span class="hook text-[0.7em] font-normal text-muted"> — {next.data.hook}</span>
          </span>
        </span>
        <span class="font-mono text-sm whitespace-nowrap">
          Read case study <span aria-hidden="true" class="nudge nudge-r">→</span>
        </span>
      </a>
    </nav>
  </main>

  <Footer />
</BaseLayout>
